
import java.util.*;

class Student {
    String rollNumber;
    String name;

    Student(String rollNumber, String name) {
        this.rollNumber = rollNumber;
        this.name = name;
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Student)) return false;

        Student s = (Student) obj;
        return rollNumber.equals(s.rollNumber);
    }

    @Override
    public int hashCode() {
        return rollNumber.hashCode();
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Set<Student> members = new HashSet<>();
        List<String> results = new ArrayList<>();

        while (sc.hasNext()) {
            String operation = sc.next();
            String roll = sc.next();
            String name = sc.next();

            Student student = new Student(roll, name);

            if (operation.equals("ADD")) {
                if (members.add(student)) {
                    results.add("Added");
                } else {
                    results.add("duplicate rejected");
                }
            } else if (operation.equals("CONTAINS")) {
                results.add(
                    "contains: " + members.contains(student)
                );
            }
        }

        for (String result : results) {
            System.out.println(result);
        }

        System.out.println("member count " + members.size());
        sc.close();
    }
}
