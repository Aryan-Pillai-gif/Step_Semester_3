
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        List<String> names = new ArrayList<>();
        List<int[]> marksList = new ArrayList<>();

        while (sc.hasNext()) {
            String name = sc.next();
            String line = sc.nextLine().trim();

            line = line.replace("[", "").replace("]", "");
            String[] values = line.split(",");

            int[] marks = new int[3];

            for (int i = 0; i < 3; i++) {
                marks[i] = Integer.parseInt(values[i].trim());
            }

            names.add(name);
            marksList.add(marks);
        }

        int n = names.size();

        if (n == 0) {
            sc.close();
            return;
        }

        int[][] grid = new int[n][3];
        int[] totals = new int[n];
        int[] subjectTotals = new int[3];

        for (int i = 0; i < n; i++) {
            grid[i] = marksList.get(i);

            for (int j = 0; j < 3; j++) {
                totals[i] += grid[i][j];
                subjectTotals[j] += grid[i][j];
            }
        }

        System.out.print("Totals ");

        for (int i = 0; i < n; i++) {
            System.out.print(names.get(i) + " " + totals[i]);

            if (i < n - 1) {
                System.out.print(", ");
            }
        }

        System.out.println();

        System.out.printf(
            Locale.US,
            "averages %.2f, %.2f, %.2f%n",
            subjectTotals[0] / (double) n,
            subjectTotals[1] / (double) n,
            subjectTotals[2] / (double) n
        );

        int topper = 0;

        for (int i = 1; i < n; i++) {
            if (totals[i] > totals[topper]) {
                topper = i;
            }
        }

        System.out.println(
            "topper " + names.get(topper) +
            " (" + totals[topper] + ")"
        );

        sc.close();
    }
}
