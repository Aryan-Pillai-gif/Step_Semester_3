
import java.util.*;

class BankAccount {
    String id;
    double balance;

    BankAccount(String id, double balance) {
        this.id = id;
        this.balance = balance;
    }

    String withdraw(double amount) {
        balance -= amount;
        return id + " balance " + (long) balance;
    }
}

class Savings extends BankAccount {
    Savings(String id, double balance) {
        super(id, balance);
    }

    @Override
    String withdraw(double amount) {
        if (balance - amount < 1000) {
            return id + " rejected: minimum balance 1000";
        }
        balance -= amount;
        return id + " balance " + (long) balance;
    }
}

class Current extends BankAccount {
    Current(String id, double balance) {
        super(id, balance);
    }

    @Override
    String withdraw(double amount) {
        if (balance - amount < -5000) {
            return id + " rejected: overdraft limit 5000";
        }
        balance -= amount;
        return id + " balance " + (long) balance;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Map<String, BankAccount> accounts = new HashMap<>();

        while (sc.hasNext()) {
            String operation = sc.next();

            if (operation.equals("Savings")) {
                String id = sc.next();
                double balance = sc.nextDouble();
                accounts.put(id, new Savings(id, balance));
            } else if (operation.equals("Current")) {
                String id = sc.next();
                double balance = sc.nextDouble();
                accounts.put(id, new Current(id, balance));
            } else if (operation.equals("WITHDRAW")) {
                String id = sc.next();
                double amount = sc.nextDouble();

                if (!accounts.containsKey(id)) {
                    System.out.println("Account not found");
                } else {
                    System.out.println(
                        accounts.get(id).withdraw(amount)
                    );
                }
            }
        }
        sc.close();
    }
}
