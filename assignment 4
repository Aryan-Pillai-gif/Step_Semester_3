
import java.util.Scanner;

class Node {
    String name;
    Node prev;
    Node next;

    Node(String name) {
        this.name = name;
        this.prev = null;
        this.next = null;
    }
}

class DoublyLinkedList {
    Node head;
    Node tail;

    // Add a coach at the end
    void addLast(String name) {
        Node newNode = new Node(name);

        if (head == null) {
            head = newNode;
            tail = newNode;
        } else {
            tail.next = newNode;
            newNode.prev = tail;
            tail = newNode;
        }
    }

    // Remove a coach by name
    void remove(String name) {
        Node current = head;

        // Find the coach
        while (current != null && !current.name.equals(name)) {
            current = current.next;
        }

        // Coach not found
        if (current == null) {
            return;
        }

        // Update the previous node or head
        if (current.prev == null) {
            head = current.next;
        } else {
            current.prev.next = current.next;
        }

        // Update the next node or tail
        if (current.next == null) {
            tail = current.prev;
        } else {
            current.next.prev = current.prev;
        }
    }

    // Print from engine end to guard end
    void printForward() {
        Node current = head;

        System.out.print("Forward: ");

        while (current != null) {
            System.out.print(current.name);
            if (current.next != null) {
                System.out.print(" <-> ");
            }
            current = current.next;
        }

        System.out.println();
    }

    // Print from guard end to engine end
    void printBackward() {
        Node current = tail;

        System.out.print("Backward: ");

        while (current != null) {
            System.out.print(current.name);
            if (current.prev != null) {
                System.out.print(" <-> ");
            }
            current = current.prev;
        }

        System.out.println();
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        DoublyLinkedList train = new DoublyLinkedList();

        // Number of coaches
        int n = sc.nextInt();

        // Read coach names
        for (int i = 0; i < n; i++) {
            train.addLast(sc.next());
        }

        // Coach to remove
        String name = sc.next();

        train.remove(name);

        // Display train in both directions
        train.printForward();
        train.printBackward();

        sc.close();
    }
}
