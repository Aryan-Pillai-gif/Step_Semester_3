
import java.util.Scanner;

class Node {
    String name;
    Node next;

    Node(String name) {
        this.name = name;
        this.next = null;
    }
}

class CircularLinkedList {
    Node tail;

    // Add a player at the end
    void addLast(String name) {
        Node newNode = new Node(name);

        if (tail == null) {
            tail = newNode;
            tail.next = tail;
        } else {
            newNode.next = tail.next;
            tail.next = newNode;
            tail = newNode;
        }
    }

    // Print players for the given number of turns
    void printTurns(int turns) {
        if (tail == null) {
            return;
        }

        Node current = tail.next;

        for (int i = 0; i < turns; i++) {
            System.out.print(current.name);

            if (i < turns - 1) {
                System.out.print(" ");
            }

            current = current.next;
        }

        System.out.println();
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        CircularLinkedList players = new CircularLinkedList();

        // Read number of players
        int n = sc.nextInt();

        // Add players
        for (int i = 0; i < n; i++) {
            players.addLast(sc.next());
        }

        // Read number of turns
        int turns = sc.nextInt();

        // Print the turn order
        players.printTurns(turns);

        sc.close();
    }
}
